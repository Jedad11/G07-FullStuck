// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  firstName      String
  lastName       String
  phoneNumber    String
  email          String    @unique
  password       String
  profilePicture String?
  bookings       Booking[]
  reviews        Review[]

  @@map("user")
}

model Resident {
  id           Int                 @id @default(autoincrement())
  residentName String
  createdAt    DateTime            @default(now())
  info         ResidentInfo?
  facilities   ResidentFacilities?
  owner        ResidentOwner?
  address      ResidentAddress?
  bookings     Booking[]
  reviews      Review[]

  @@map("resident")
}

model ResidentInfo {
  id           Int      @id @default(autoincrement())
  residentId   Int      @unique
  resident     Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  residentType String
  building     String
  roomType     String
  electricFee  Float
  waterFee     Float
  rentalPrice  Int

  @@map("resident_info")
}

model ResidentFacilities {
  id             Int      @id @default(autoincrement())
  residentId     Int      @unique
  resident       Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  aircon         Boolean  @default(false)
  furnished      Boolean  @default(false)
  television     Boolean  @default(false)
  waterHeater    Boolean  @default(false)
  inRoomBathroom Boolean  @default(false)
  refrigerator   Boolean  @default(false)
  pool           Boolean  @default(false)
  parking        Boolean  @default(false)
  security       Boolean  @default(false)
  fitness        Boolean  @default(false)
  internet       Boolean  @default(false)

  @@map("resident_facilities")
}

model ResidentOwner {
  id               Int      @id @default(autoincrement())
  residentId       Int      @unique
  resident         Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  ownerName        String
  ownerPhone       String
  ownerEmail       String
  ownerContactLine String?

  @@map("resident_owner")
}

model ResidentAddress {
  id          Int      @id @default(autoincrement())
  residentId  Int      @unique
  resident    Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  houseNumber String
  street      String
  subDistrict String
  district    String
  province    String
  postalCode  String

  @@map("resident_address")
}

model Booking {
  id           Int      @id @default(autoincrement())
  residentId   Int
  resident     Resident @relation(fields: [residentId], references: [id])
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  firstName    String
  lastName     String
  email        String
  phoneNumber  String
  roomType     String
  bedType      String
  checkInDate  DateTime
  checkOutDate DateTime

  @@map("booking")
}

model Review {
  id                Int      @id @default(autoincrement())
  residentId        Int
  resident          Resident @relation(fields: [residentId], references: [id])
  userId            Int
  user              User     @relation(fields: [userId], references: [id])
  cleanlinessRating Float
  serviceRating     Float
  locationRating    Float
  facilitiesRating  Float
  overallRating     Float
  message           String
  guestStatus       String
  stayPeriod        String
  createdAt         DateTime @default(now())

  @@map("review")
}
